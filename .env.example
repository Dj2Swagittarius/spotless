# Copy to .env (git-ignored) and adjust. Every variable is optional; the defaults shown are the
# values the code falls back to. Docker Compose reads .env automatically; `next dev` does too.

# --- Paths -------------------------------------------------------------------------------------
# Folder scanned and streamed by Spotless (read-only is fine). Default: ./music outside Docker, /music inside.
MUSIC_DIR=/music
# Optional read/write mirror of the same library, used only to create generated .lrc sidecars.
MUSIC_WRITE_DIR=/music-write
# SQLite database, extracted album art and backups. Default: ./data outside Docker, /data inside.
DATA_DIR=/data
# Where daily database backups are written. Default: <DATA_DIR>/backups.
BACKUP_DIR=/data/backups
# Path to the ffmpeg binary used for transcoding (bundled in the Docker image).
FFMPEG_PATH=ffmpeg

# --- Server -------------------------------------------------------------------------------------
# HTTP port and bind address for the production server.
PORT=3000
HOSTNAME=0.0.0.0
# Log verbosity: debug | info | warn | error.
LOG_LEVEL=info
# Docker only: uid/gid the app runs as after the entrypoint fixes /data ownership.
PUID=1000
PGID=1000

# --- Authentication -----------------------------------------------------------------------------
# Minimum web password length. 4 allows a PIN on a home LAN; use 12+ when reachable from the internet.
AUTH_MIN_PASSWORD_LENGTH=4
# Force the session cookie's Secure flag (true/false). Unset = auto-detect from HTTPS / X-Forwarded-Proto.
AUTH_SECURE_COOKIE=
# Number of trusted reverse-proxy hops. Unset = ignore X-Forwarded-For (it can be forged).
TRUST_PROXY=

# --- Integrations -------------------------------------------------------------------------------
# Shared secret for the Lidarr webhook (?token=<secret>). Unset = webhook is unauthenticated.
LIDARR_WEBHOOK_SECRET=change-me
# Spotify app client id; enables the taste/playlist import.
SPOTIFY_CLIENT_ID=your_spotify_app_client_id
# Deployment default for the Spotify OAuth callback; Settings -> Spotify overrides it.
SPOTIFY_REDIRECT_URI=https://music.example.com/api/spotify/callback

# --- AI DJ (all optional; Settings -> AI DJ overrides these defaults) ---------------------------
# Default LLM provider id (ollama, lmstudio, openai, anthropic, ...) and model id.
DJ_PROVIDER=ollama
DJ_MODEL=
# Local LLM servers. Inside Docker use http://host.docker.internal:<port> to reach the host.
OLLAMA_URL=http://localhost:11434
LMSTUDIO_URL=http://localhost:1234/v1
# Local speech servers: text-to-speech (Kokoro) and speech-to-text (Speaches / Whisper).
TTS_URL=http://localhost:8880/v1
STT_URL=http://localhost:8000/v1
# Hosted provider keys (keys saved in Settings take priority). Leave blank to disable.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
ELEVENLABS_API_KEY=
