# Copy to .env (git-ignored) and uncomment what you want to change. Every variable is optional and
# every line below is commented out, so a straight copy changes nothing. The values shown are the
# code's own defaults unless the comment says otherwise. `next dev` / `next start` read .env, and
# docker-compose.yml passes it into the container via `env_file:` (`environment:` entries there win).

# --- Paths (local checkout only: the Docker image sets its own, so leave these commented out when
# --- running with Docker, or the container will look for ./music and ./data inside the image) ---
# Folder scanned and streamed by Spotless (read-only is fine). The Docker image sets /music.
# MUSIC_DIR=./music
# Optional read/write mirror of the same library, used only to create generated .lrc sidecars.
# Default: same as MUSIC_DIR. The Docker image sets /music-write.
# MUSIC_WRITE_DIR=./music
# SQLite database, extracted album art and backups. The Docker image sets /data.
# DATA_DIR=./data
# Where daily database backups are written. Default: <DATA_DIR>/backups.
# BACKUP_DIR=./data/backups
# Path to the ffmpeg binary used for transcoding (bundled in the Docker image).
# FFMPEG_PATH=ffmpeg
# Maximum concurrent ffmpeg transcodes; extra listeners get the raw file. Default: number of CPU cores.
# TRANSCODE_MAX_ACTIVE=4

# --- Server -------------------------------------------------------------------------------------
# HTTP port and bind address for the production server.
# PORT=3000
# HOSTNAME=0.0.0.0
# Log verbosity: debug | info | warn | error.
# LOG_LEVEL=info
# Docker only: uid/gid the app runs as after the entrypoint fixes /data ownership.
# PUID=1000
# PGID=1000

# --- Authentication -----------------------------------------------------------------------------
# Minimum web password length. 4 allows a PIN on a home LAN; use 12+ when reachable from the internet.
# AUTH_MIN_PASSWORD_LENGTH=4
# Force the session cookie's Secure flag (true/false). Unset = auto-detect from HTTPS / X-Forwarded-Proto.
# AUTH_SECURE_COOKIE=true
# Number of trusted reverse-proxy hops. Unset = ignore X-Forwarded-For (it can be forged).
# TRUST_PROXY=1

# --- Integrations -------------------------------------------------------------------------------
# Shared secret for the Lidarr webhook (?token=<secret>). Unset = webhook is unauthenticated.
# LIDARR_WEBHOOK_SECRET=
# Spotify app client id; enables the taste/playlist import.
# SPOTIFY_CLIENT_ID=
# Deployment default for the Spotify OAuth callback; Settings -> Spotify overrides it.
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback
# Set to 1 to allow internet radio stations on loopback / LAN / link-local IP addresses (e.g. a local
# Icecast box). Off by default so the station proxy cannot reach other services on your network.
# ALLOW_PRIVATE_STREAM_URLS=1

# --- AI DJ (all optional; Settings -> AI DJ overrides these defaults) ---------------------------
# Default LLM provider id (ollama, lmstudio, openai, anthropic, ...) and model id.
# DJ_PROVIDER=ollama
# DJ_MODEL=
# Local LLM servers. Inside Docker use http://host.docker.internal:<port> to reach the host.
# OLLAMA_URL=http://localhost:11434
# LMSTUDIO_URL=http://localhost:1234/v1
# Local speech servers: text-to-speech (Kokoro) and speech-to-text (Speaches / Whisper).
# TTS_URL=http://localhost:8880/v1
# STT_URL=http://localhost:8000/v1
# Hosted provider keys (keys saved in Settings take priority). Leave unset to disable.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# MISTRAL_API_KEY=
# DEEPSEEK_API_KEY=
# XAI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# ELEVENLABS_API_KEY=
