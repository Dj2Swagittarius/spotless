<?xml version="1.0" encoding="utf-8"?>
<!-- Android TV home row tile (320x180dp): the app icon on black -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="320dp" android:height="180dp" />
            <solid android:color="#000000" />
        </shape>
    </item>
    <item android:width="120dp" android:height="120dp" android:gravity="center" android:drawable="@mipmap/ic_launcher" />
</layer-list>
